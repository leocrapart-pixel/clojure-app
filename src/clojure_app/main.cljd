(ns clojure-app.main
  "Le Voyage de Vénus — point d'entrée de l'application."
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [clojure-app.astro :as astro]
            [clojure-app.theme :as th]
            [clojure-app.ui :as ui]))

(def now-jd (astro/jd-of (DateTime.now)))

(def app-state (atom {:jd now-jd :open nil}))

(defn main []
  (m/runApp
    (f/widget
      :watch [state app-state]
      (m/MaterialApp
        .title "Le Voyage de Vénus"
        .debugShowCheckedModeBanner false
        .theme
        (m/ThemeData
          .brightness m/Brightness.dark
          .scaffoldBackgroundColor th/bg-deep
          .colorScheme
          (m/ColorScheme.dark
            .primary th/venus
            .surface th/panel))
        .home (ui/page state app-state now-jd)))))
